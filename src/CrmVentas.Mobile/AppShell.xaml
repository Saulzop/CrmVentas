<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CrmVentas.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CrmVentas.Mobile.Vistas"
    Title="CrmVentas">

    <ShellContent
        Route="login"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <ShellContent
            Title="Clientes"
            Route="clientes"
            ContentTemplate="{DataTemplate views:ClientesPage}" />
        <ShellContent
            Title="Productos"
            Route="productos"
            ContentTemplate="{DataTemplate views:ProductosPage}" />
        <ShellContent
            Title="Pedidos"
            Route="pedidos"
            ContentTemplate="{DataTemplate views:PedidosPage}" />
    </TabBar>

</Shell>
