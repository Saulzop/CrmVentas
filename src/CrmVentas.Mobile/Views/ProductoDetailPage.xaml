<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrmVentas.Mobile.ViewModels"
             x:Class="CrmVentas.Mobile.Views.ProductoDetailPage"
             x:DataType="vm:ProductoDetailViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="SKU *" FontAttributes="Bold" />
            <Entry Text="{Binding Sku}" Placeholder="SKU único" IsEnabled="{Binding EsEdicion, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Nombre *" FontAttributes="Bold" />
            <Entry Text="{Binding Nombre}" Placeholder="Nombre del producto" />

            <Label Text="Descripción" FontAttributes="Bold" />
            <Entry Text="{Binding Descripcion}" Placeholder="Descripción" />

            <Label Text="Precio *" FontAttributes="Bold" />
            <Entry Text="{Binding Precio}" Keyboard="Numeric" />

            <Label Text="Stock *" FontAttributes="Bold" />
            <Entry Text="{Binding Stock}" Keyboard="Numeric" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
