<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrmVentas.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:CrmVentas.Application.Dtos;assembly=CrmVentas.Application"
             x:Class="CrmVentas.Mobile.Views.ClientesPage"
             x:Name="root"
             x:DataType="vm:ClientesViewModel"
             Title="Clientes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Agregar" Command="{Binding AgregarCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding CargarCommand}">
        <Grid RowDefinitions="Auto,*">
            <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Margin="16,8" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Clientes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ClienteDto">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                <Label Text="{Binding Email}" FontSize="13" Opacity="0.7" />
                                <Label Text="{Binding Telefono}" FontSize="13" Opacity="0.7" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Editar" Margin="4,0"
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.EditarCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Eliminar" BackgroundColor="IndianRed"
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.EliminarCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
