<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrmVentas.Mobile.ViewModel"
             x:Class="CrmVentas.Mobile.Vistas.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Iniciar sesión">

    <Grid Padding="30" VerticalOptions="Center" RowSpacing="16">
        <VerticalStackLayout Spacing="16" VerticalOptions="Center">
            <Label Text="CrmVentas" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Mini CRM de ventas" FontSize="16" HorizontalOptions="Center" Opacity="0.7" />

            <Entry Placeholder="Usuario" Text="{Binding NombreUsuario}" Margin="0,20,0,0" />
            <Entry Placeholder="Contraseña" Text="{Binding Password}" IsPassword="True" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center" />

            <Button Text="Entrar" Command="{Binding IniciarSesionCommand}" Margin="0,10,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
