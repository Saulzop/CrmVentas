<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrmVentas.Mobile.ViewModel"
             xmlns:dtos="clr-namespace:CrmVentas.Application.Dtos;assembly=CrmVentas.Application"
             x:Class="CrmVentas.Mobile.Vistas.ProductosPage"
             x:Name="root"
             x:DataType="vm:ProductosViewModel"
             Title="Productos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Agregar" Command="{Binding AgregarCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding CargarCommand}">
        <Grid RowDefinitions="Auto,*">
            <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Margin="16,8" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Productos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ProductoDto">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                <Label Text="{Binding Sku}" FontSize="12" Opacity="0.6" />
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="$" />
                                            <Span Text="{Binding Precio, StringFormat='{0:0.00}'}" />
                                            <Span Text="  ·  Stock: " />
                                            <Span Text="{Binding Stock}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Editar" Margin="4,0"
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.EditarCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Eliminar" BackgroundColor="IndianRed"
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.EliminarCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
